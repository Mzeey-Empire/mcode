{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn",
    "oxc"
  ],
  "jsPlugins": [
    "./packages/oxlint-plugin/dist/index.mjs"
  ],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "complexity": ["error", { "max": 10 }],
    "max-depth": ["warn", 4],
    "no-control-regex": "off",
    "no-unused-vars": "warn",
    "react/set-state-in-effect": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react/no-children-prop": "off",
    "react/preserve-manual-memoization": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/static-components": "off",
    "react/use-memo": "off",
    "mcode/namespace-node-imports": "error",
    "mcode/no-function-scope-zod-schema": "error",
    "mcode/no-global-host-runtime": "error",
    "mcode/no-native-title-tooltip": "error",
    "mcode/require-lazy-nontrivial-schema": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@phosphor-icons/react",
            "message": "Product icons are Lucide. Import from @/components/ui/icon-map or lucide-react (DESIGN.md Iconography)."
          }
        ]
      }
    ],
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "excludeFiles": ["apps/server/src/features/pull-requests/links/pull-request-link-funnel.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [{ "name": "@phosphor-icons/react", "message": "Product icons are Lucide." }],
          "patterns": [
            { "group": ["**/thread-pull-request-write-operations*"], "message": "Only PullRequestLinkFunnel admits PR link writes." },
            { "group": ["**/sqlite/schema*"], "importNames": ["threadPullRequests"], "message": "Only PullRequestLinkFunnel owns the PR link table." }
          ]
        }]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"],
      "rules": {
        "mcode/use-test-builder": ["error", {
          "shapes": [
            { "type": "Thread", "builder": "createMockThread", "from": "@mcode/contracts/testing", "keys": ["title", "worktree_path", "checkout_state"] },
            { "type": "Message", "builder": "createMockMessage", "from": "@mcode/contracts/testing", "keys": ["thread_id", "role", "tool_calls", "files_changed"] },
            { "type": "Workspace", "builder": "createMockWorkspace", "from": "@mcode/contracts/testing", "keys": ["path", "provider_config", "is_git_repo"] },
            { "type": "ApprovalRequest", "builder": "createMockApproval", "from": "@mcode/contracts/testing", "keys": ["requestId", "subject", "choices", "origin"] }
          ]
        }]
      }
    },
    {
      "files": ["apps/web/src/**/*.test.ts", "apps/web/src/**/*.test.tsx", "apps/web/src/**/__tests__/**"],
      "rules": {
        "mcode/no-inline-module-mock": ["error", { "modules": { "@/transport": { "name": "mockTransport", "from": "@/__tests__/mocks/transport" } } }]
      }
    },
    {
      "files": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
      "rules": {
        "mcode/no-ellipsis-truncation": "error",
        "mcode/no-arbitrary-text-size": "error",
        "mcode/no-numeric-z-index": "error",
        "mcode/no-raw-color": "error",
        "mcode/no-raw-shadow": "error"
      }
    },
    {
      "files": ["apps/web/src/**/__tests__/**", "apps/web/src/**/*.test.*", "apps/web/src/**/*.spec.*", "apps/web/src/performance/**"],
      "rules": {
        "mcode/no-raw-color": "off",
        "mcode/no-raw-shadow": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "mcode/no-source-text-test": "error"
      }
    },
    {
      "files": ["apps/web/src/**/*.test.ts", "apps/web/src/**/*.test.tsx"],
      "rules": {
        "mcode/no-real-timer-sleep": "error"
      }
    },
    {
      "files": ["apps/web/src/**/EditorIcons.tsx", "apps/web/src/**/ProviderIcons.tsx", "apps/web/src/lib/file-icons.tsx", "apps/web/src/lib/vscode-icons.ts", "apps/web/src/features/projects/actions/action-icons.ts", "apps/web/src/components/chat/ImageAttachmentLightbox.tsx"],
      "rules": {
        "mcode/no-raw-color": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "out/**",
    "build/**",
    "node_modules/**",
    ".dev/**",
    ".opensrc/**",
    "release/**"
  ]
}
