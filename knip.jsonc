{
  "$schema": "./node_modules/knip/schema.json",
  // Locally used declarations remain live; surplus export modifiers are deferred to the follow-up audit. See #2198.
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,ts}",
        "docs/plans/ready-for-build/tools/*.mjs"
      ],
      "project": [
        "scripts/**/*.{mjs,ts}"
      ],
      "ignoreDependencies": [
        // Existing dependency or hoisted import; audit ownership before removal.
        "@anthropic-ai/claude-agent-sdk",
        // Existing dependency or hoisted import; audit ownership before removal.
        "opensrc",
        // Existing dependency or hoisted import; audit ownership before removal.
        "reflect-metadata",
        // Existing dependency or hoisted import; audit ownership before removal.
        "ws"
      ]
    },
    "apps/web": {
      "entry": [
        "src/index.css",
        "scripts/**/*.{mjs,ts}"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "scripts/**/*.{mjs,ts}",
        "*.ts"
      ],
      "ignoreDependencies": [
        // Existing dependency or hoisted import; audit ownership before removal.
        "@radix-ui/react-dropdown-menu",
        // Existing dependency or hoisted import; audit ownership before removal.
        "@radix-ui/react-popover",
        // Existing dependency or hoisted import; audit ownership before removal.
        "@tanstack/react-router",
        // Existing dependency or hoisted import; audit ownership before removal.
        "@types/hast"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/main/preload.ts",
        "src/main/snapshot-entry.ts",
        "src/features/preview/preload/guest-input.ts",
        "scripts/**/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.{mjs,ts}",
        "*.ts"
      ],
      "ignoreDependencies": [
        // Existing dependency or hoisted import; audit ownership before removal.
        "@types/uuid",
        // Existing dependency or hoisted import; audit ownership before removal.
        "@types/which",
        // Existing dependency or hoisted import; audit ownership before removal.
        "electron-mksnapshot",
        // Existing dependency or hoisted import; audit ownership before removal.
        "koffi",
        // Existing dependency or hoisted import; audit ownership before removal.
        "node-pty",
        // Existing dependency or hoisted import; audit ownership before removal.
        "uuid",
        // Existing dependency or hoisted import; audit ownership before removal.
        "which"
      ]
    },
    "apps/server": {
      "entry": [
        "src/features/terminal/host/pty-host-entry.ts",
        "src/**/*.worker.ts",
        "scripts/**/*.{mjs,ts}"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.{mjs,ts}",
        "*.ts"
      ],
      "ignoreDependencies": [
        // Existing dependency or hoisted import; audit ownership before removal.
        "@anthropic-ai/claude-agent-sdk",
        // Existing dependency or hoisted import; audit ownership before removal.
        "@github/copilot-sdk",
        // Existing dependency or hoisted import; audit ownership before removal.
        "@swc/cli",
        // Existing dependency or hoisted import; audit ownership before removal.
        "@swc/core",
        // Existing dependency or hoisted import; audit ownership before removal.
        "koffi",
        // Existing dependency or hoisted import; audit ownership before removal.
        "smol-toml",
        // Existing dependency or hoisted import; audit ownership before removal.
        "vite-node"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/providers": {
      "entry": [
        "src/conformance/plan-probes/probe.ts"
      ]
    },
    "packages/contracts": {
      "entry": [
        "src/**/*.type-test.ts"
      ]
    },
    "packages/browser-conformance": {
      "ignoreDependencies": [
        // Existing unused workspace dependency; no retirement row authorizes its removal.
        "@mcode/contracts"
      ]
    }
  },
  "ignoreBinaries": [
    // Provider CLI installed by the user, not an npm executable.
    "codex",
    // Host OS command used by process integration tests.
    "ping",
    // Windows process inventory command used by cleanup and tests.
    "tasklist"
  ],
